# Required. The server refuses to start if either value is missing or blank.
OPENROUTER_API_KEY=
CANDIDATE_TOKEN=

# `npm run setup` writes only the two required keys to .env. Put optional
# settings in .env.local, which Next.js also loads and Git ignores.

# Optional
# Path to the SQLite database file. Created and seeded automatically on first
# server boot when the file does not exist yet.
DATABASE_PATH=./data/apex.db

# Optional. Forces the session cookie's `Secure` flag. Defaults to `true` in
# production and `false` otherwise; set to `false` if you run a production build
# over plain HTTP (e.g. `npm start` on http://localhost:8080).
AUTH_COOKIE_SECURE=
